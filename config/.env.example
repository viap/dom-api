# Copy to config/.env for local development. Production values come from
# GitHub environment secrets (see .github/workflows/deployment.yml).

NODE_ENV=dev
PORT=3003
WEBSOCKET_PORT=3004

# Comma-separated exact web origins allowed by CORS
CORS_ORIGINS=http://localhost:3006
# Site origin used in application notification links
PUBLIC_WEB_URL=http://localhost:3006

MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DBNAME=domData
MONGO_INITDB_ROOT_USERNAME=change-me
MONGO_INITDB_ROOT_PASSWORD=change-me

# At least 32 characters
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars

# API clients. The bot client is the only one allowed to log in by Telegram id;
# dom-web uses the web client (its API_CLIENT_NAME/API_CLIENT_PASSWORD must match).
BOT_CLIENT_NAME=domBot
BOT_CLIENT_PASSWORD=change-me
WEB_CLIENT_NAME=domWeb
WEB_CLIENT_PASSWORD=change-me
